/*
 * Progression layout: the quest at the top left and the reward reveals.
 * Colours come from Theme.uss variables; type comes from its t-* classes.
 */

/* Quest: plain text on the world above the inspect card, lined up with the numbers over it */

.quest {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 12px 0 0 12px;
}

.quest__header {
    flex-direction: row;
    align-items: center;
}

.quest__chapter {
    flex-shrink: 1;
    font-size: 17px;
}

.quest.is-complete .quest__chapter {
    color: var(--good);
}

/* Folds the card to its heading and title, and back: the action in words right after the chapter line. */
.quest__toggle {
    margin-left: 6px;
    font-size: 16px;
}

.quest__toggle > .glyph {
    width: 15px;
    height: 15px;
    margin-right: 4px;
}

.quest.is-collapsed .quest__toggle > .glyph {
    rotate: 180deg;
}

/* How far the goals are; only the folded card shows it, the open one lists every goal. */
.quest__progress {
    display: none;
    margin-left: 8px;
    font-size: 19px;
    color: var(--accent);
}

.quest.is-collapsed .quest__progress {
    display: flex;
}

.quest.is-complete .quest__progress {
    color: var(--good);
}

.quest__title {
    margin-top: 4px;
    font-size: 34px;
    white-space: normal;
}

.quest__description {
    margin-top: 8px;
    font-size: 19px;
    white-space: normal;
}

.quest__goals {
    margin-top: 10px;
}

.quest-goal {
    flex-direction: row;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
}

.quest-goal__check {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-right: 10px;
    border-radius: 11px;
    border-width: 2px;
    border-color: var(--ink-soft);
    background-color: rgba(255, 255, 255, 0.85);
}

.quest-goal.is-done .quest-goal__check {
    border-color: var(--good);
    background-color: var(--good-fill);
}

/* the count follows its goal's words rather than standing at the far edge */
.quest-goal__text {
    flex-shrink: 1;
    font-size: 19px;
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
    white-space: normal;
}

.quest-goal.is-done .quest-goal__text {
    color: var(--ink-soft);
}

.quest-goal__count {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 19px;
    color: var(--accent);
}

.quest-goal.is-done .quest-goal__count {
    color: var(--good);
}

.quest__reward {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 10px;
}

.quest__reward-caption {
    margin-right: 8px;
}

.quest__reward-items {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
}

.quest-reward-chip {
    flex-direction: row;
    align-items: center;
    margin: 2px 12px 2px 0;
}

.quest-reward-chip__art {
    width: 36px;
    height: 36px;
    margin-right: 4px;
}

.quest-reward-chip__text {
    font-size: 17px;
}

.quest__claim {
    margin-top: 12px;
    min-height: 52px;
    font-size: 18px;
}

/*
 * Quest reward: a disc in the light, no card (RewardOverlay). Text with its halo straight on the deep veil;
 * the reward on a white disc with a breathing glow and slow pale rays behind it.
 */

.reward {
    max-width: 1000px;
    align-items: center;
}

.reward__eyebrow {
    font-size: 19px;
    color: var(--ink-soft);
    -unity-text-align: middle-center;
}

.reward__quest {
    margin-top: 4px;
    font-size: 36px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/*
 * 380 square: disc.png's 284 px circle fills it with its shadow; the glow and the rays are centred on it. The
 * quest's heading hangs above it, inside it in the tree, so the rays draw under the words; the top margin
 * keeps the heading's room.
 */
.reward__stage {
    width: 380px;
    height: 380px;
    margin-top: 104px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.reward__glow {
    position: absolute;
    left: -194px;
    top: -194px;
    width: 768px;
    height: 768px;
    background-image: url("../Sprites/glow.png");
}

.reward__rays {
    position: absolute;
    left: -266px;
    top: -266px;
    width: 912px;
    height: 912px;
    background-image: url("../Sprites/rays.png");
}

.reward__head {
    position: absolute;
    left: -310px;
    right: -310px;
    bottom: 100%;
    margin-bottom: 22px;
    align-items: center;
}

.reward__disc {
    width: 380px;
    height: 380px;
    align-items: center;
    justify-content: center;
    background-image: url("../Sprites/disc.png");
}

/* the disc's face: the turning model or the picture, clipped round */
.reward__window {
    width: 284px;
    height: 284px;
    overflow: hidden;
    border-radius: 142px;
    background-color: var(--paper-soft);
}

.reward__prize {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.reward__prize-image {
    width: 216px;
    height: 216px;
}

.reward__monogram {
    font-size: 96px;
    color: var(--coin-deep);
}

.reward__kind {
    font-size: 18px;
    color: var(--accent);
}

.reward__name {
    font-size: 72px;
    -unity-text-align: middle-center;
}

/* a building's size, workers and recipes: a glyph or a resource picture beside each number */
.reward__facts {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    max-width: 980px;
    margin-top: 8px;
}

.reward__fact {
    flex-direction: row;
    align-items: center;
    margin: 4px 15px;
}

.reward__fact > .glyph {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--ink-soft);
}

.reward__fact-icon {
    width: 38px;
    height: 38px;
    margin-left: 4px;
    margin-right: 2px;
}

.reward__fact-text {
    font-size: 20px;
}

.reward__fact-note {
    margin-left: 6px;
}

.reward__fact-arrow {
    margin: 0 8px;
    font-size: 20px;
    color: var(--ink-soft);
}

.reward__description {
    max-width: 760px;
    margin-top: 8px;
    font-size: 19px;
    color: var(--ink-soft);
    -unity-text-align: middle-center;
    white-space: normal;
}

.reward__where {
    margin-top: 10px;
    font-size: 19px;
    color: var(--ink-soft);
    -unity-text-align: middle-center;
}

.reward__extras {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 6px;
}

.reward__extra {
    margin: 2px 10px;
    font-size: 20px;
    color: var(--coin-deep);
}

.reward__claim {
    min-width: 312px;
    min-height: 62px;
    margin-top: 20px;
    border-radius: 31px;
    font-size: 22px;
}

/*
 * Battle prize: three white discs, no machine (BattleRewardOverlay). The battle's banner, one reel per digit
 * inside a disc, sparks as each lands; on claim the coins fly from the amount to the treasury.
 */

.jackpot {
    align-items: center;
}

.jackpot__banner {
    font-size: 94px;
    color: var(--coin);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ink);
    -unity-text-align: middle-center;
}

.jackpot__title {
    margin-top: 4px;
    font-size: 22px;
    color: var(--ink-soft);
}

.jackpot__machine {
    margin-top: 14px;
    align-items: center;
    justify-content: center;
}

.jackpot__reels {
    flex-direction: row;
    align-items: center;
}

.jackpot__coin {
    width: 120px;
    height: 120px;
    margin-right: 8px;
}

/* disc.png's 180 px circle in this 240 box; the margins pull the shadows in so the circles stand 26 px apart */
.jackpot__reel {
    width: 240px;
    height: 240px;
    margin: -12px -17px;
    align-items: center;
    justify-content: center;
    background-image: url("../Sprites/disc.png");
}

/* one digit shows at a time: the window is one .jackpot__digit tall (BattleRewardOverlay.DigitHeight) */
.jackpot__window {
    width: 180px;
    height: 180px;
    overflow: hidden;
    border-radius: 90px;
}

.jackpot__strip {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
}

.jackpot__digit {
    height: 180px;
    font-size: 112px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

/* the sparks start at the disc's centre and are moved out by code */
.jackpot__burst {
    position: absolute;
    left: 120px;
    top: 120px;
    width: 0;
    height: 0;
}

.jackpot__spark {
    position: absolute;
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--coin);
}

.jackpot__range {
    margin-top: 16px;
    font-size: 19px;
    color: var(--ink-soft);
}

.jackpot__amount {
    min-height: 64px;
    margin-top: 4px;
    font-size: 55px;
    color: var(--coin-deep);
    -unity-text-align: middle-center;
}

.jackpot__claim {
    min-width: 312px;
    min-height: 62px;
    margin-top: 14px;
    border-radius: 31px;
    font-size: 22px;
}

/* the coins' flight to the treasury: left/top from code mark each coin's centre */
.jackpot__flight {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.jackpot__flying {
    position: absolute;
    width: 60px;
    height: 60px;
    margin-left: -30px;
    margin-top: -30px;
}
