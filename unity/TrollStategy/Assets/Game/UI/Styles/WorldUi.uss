/*
 * UI over things in the world: building names, cargo counts, refusal toasts, sale gains, damage numbers
 * and fighter health. Each is a small world-space UIDocument (WorldPanel) whose elements are built in
 * code with these classes. The panel settings map 100 panel pixels to one world unit, so a 24px label
 * stands 0.24 units tall up close; as the colony camera backs off, WorldPanel grows the panel so its
 * largest text keeps 18px on a 1080px screen, and far away it marks the content .world-panel--far,
 * under which details drop out. Like the HUD, words are dark ink with a white rim and stand on no plate;
 * numbers that fly (gold, damage) keep their colour and take an ink rim. Colours come from Theme.uss.
 */

.world-label {
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--halo);
    text-shadow: 0 0 4px var(--halo);
    margin: 0;
    padding: 0;
}

/* Over a hovered or targeted building: its name, then workers and stock. */
.world-label--building {
    font-size: 24px;
}

.world-label--building-info {
    font-size: 19px;
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
}

/* Beside a hauler's cargo icon; far away the counts would crowd the haulers. */
.world-label--cargo {
    font-size: 20px;
}

.world-panel--far .world-label--cargo {
    display: none;
}

/* Why a building or order was refused, where it happened. */
.world-label--toast {
    font-size: 50px;
    color: var(--bad);
    -unity-text-outline-width: 3px;
}

/* Gold a sale brought, rising from the market. */
.world-label--gain {
    font-size: 60px;
    -unity-font-definition: url("../Fonts/Nunito-Black.ttf");
    color: var(--coin);
    -unity-text-align: middle-left;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #5C3F00;
}

/* Damage over a fighter; the size of the blow sets the font size and the colour in code. */
.world-label--damage {
    font-size: 54px;
    -unity-font-definition: url("../Fonts/Nunito-Black.ttf");
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}

/* Fighter health: the number over a bar with a pale chip that lags behind the fill. */
.hp-bar {
    align-items: center;
}

.hp-bar__label {
    font-size: 22px;
    margin-bottom: 2px;
}

.hp-bar__track {
    width: 69px;
    height: 14px;
    padding: 3px;
    border-radius: 7px;
    background-color: var(--ink);
}

.hp-bar__inside {
    flex-grow: 1;
    border-radius: 4px;
    overflow: hidden;
}

.hp-bar__chip,
.hp-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
}

.hp-bar__chip {
    background-color: var(--paper);
}

/*
 * The fighter's gear at the bar's sides: the weapon on the left, armour and helmet on the right. The groups
 * hang outside the bar, so it stays centred over the fighter however many tokens there are.
 */
.hp-bar__row {
    align-items: center;
    /* room for three tokens a side and their height, inside the panel the document sizes by its content */
    padding: 11px 76px;
}

.hp-bar__gear {
    position: absolute;
    top: -10.5px;
    flex-direction: row;
    align-items: center;
}

.hp-bar__gear--left {
    right: 100%;
    margin-right: 3px;
    flex-direction: row-reverse;
}

.hp-bar__gear--right {
    left: 100%;
    margin-left: 3px;
}

/* One worn item: a white disc with its shadow (disc.png, the 26 px circle in a 35 px box) and the item's picture. */
.hp-gear {
    width: 35px;
    height: 35px;
    margin: 0 -3px;
    align-items: center;
    justify-content: center;
    background-image: url("../Sprites/disc.png");
    -unity-background-image-tint-color: var(--paper);
}

.hp-gear__art {
    width: 21px;
    height: 21px;
}

/* enchanted: the violet rim of the enchanter's work */
.hp-gear__rim {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 2.5px;
    border-color: var(--magic);
}

/* a free slot while the squad is placed: a dark hollow with the slot's pictogram, asking for an item */
.hp-gear--empty {
    background-image: none;
    width: 25px;
    height: 25px;
    margin: 5px 3px;
    border-radius: 13px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    background-color: rgba(30, 42, 64, 0.3);
}

.hp-gear--empty > .glyph {
    width: 15px;
    height: 15px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.95);
}

/* Land mode: the price over a block for sale; red while the treasury is short, blue on the picked block. */
.land-price {
    font-size: 58px;
    -unity-text-outline-width: 3px;
}

.land-price--short {
    color: var(--bad);
}

.land-price--picked {
    font-size: 76px;
    color: var(--accent);
}

/* A block being cleared: seconds left over a bar that fills. */
.land-bar {
    align-items: center;
}

.land-bar__label {
    font-size: 56px;
    margin-bottom: 6px;
    -unity-text-outline-width: 3px;
}

.land-bar__track {
    width: 360px;
    height: 40px;
    padding: 7px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.92);
    border-width: 2px;
    border-color: var(--paper-line);
}

.land-bar__fill {
    height: 100%;
    width: 0;
    border-radius: 13px;
    background-color: var(--coin);
}
