/*
 * Colony HUD layout. Across the top: the colony's numbers on the left, the round tools down the right edge.
 * The left column holds the quest as plain text and the inspected thing on mist; the catalog is a tray of
 * round tokens along the bottom, its tabs at the left end and the latest word from the colony at the right.
 * The order prompt floats at the top in the middle. Each part is a nested UIDocument; the frame, bands and columns are documents without
 * UXML whose root elements take the classes below from UiDocumentClasses.
 */

.hud-root {
    flex-grow: 1;
    padding: 18px 24px 16px 24px;
}

/* A band of the frame that keeps its content's height. */
.hud-band {
    flex-shrink: 0;
}

/* Top: numbers and tools */

.top-bar {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    min-height: 56px;
}

.resources {
    flex-direction: row;
    align-items: center;
}

/* One number with its picture; the name is in the hint. */
.resource {
    flex-direction: row;
    align-items: center;
    margin-right: 34px;
}

.resource__icon {
    width: 56px;
    height: 56px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.resource__value {
    font-size: 34px;
}

.resource__note {
    margin-left: 6px;
    font-size: 17px;
    color: var(--ink-soft);
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
}

/* The tools down the right edge: caption on the left, round button on the right. */
.tools {
    position: absolute;
    right: -12px;
    top: -12px;
    align-items: flex-end;
}

.tool {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: -10px;
}

.tool__caption {
    margin-right: 2px;
    font-size: 18px;
}

/* disc.png: the 70 px circle sits in the middle of this box */
.tool__button {
    width: 94px;
    height: 94px;
}

.tool__button > .glyph {
    width: 32px;
    height: 32px;
}

/* Middle band: left column, free map, right column */

.middle {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    margin-top: 10px;
    margin-bottom: 8px;
}

.left-column {
    width: 460px;
    flex-shrink: 0;
    align-items: stretch;
    margin-left: -12px;
}

/* The model preview sits low on the right, clear of the tools. */
.right-column {
    flex-shrink: 0;
    justify-content: flex-end;
    align-items: flex-end;
}

/* Inspect card */

.inspect__header {
    flex-direction: row;
    align-items: flex-start;
}

.inspect__titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.inspect__title {
    font-size: 27px;
    white-space: normal;
}

.inspect__subtitle {
    margin-top: 2px;
    font-size: 15px;
    color: var(--ink-soft);
}

.slots-header {
    margin-top: 12px;
    margin-bottom: 6px;
    font-size: 15px;
    color: var(--ink-soft);
}

.slots {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 40px;
    height: 40px;
    margin-right: 5px;
    margin-bottom: 5px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--paper-line);
    background-color: rgba(255, 255, 255, 0.55);
}

.slot.is-filled {
    background-color: var(--paper);
}

.slot__icon {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
}

.slot__count {
    position: absolute;
    right: 3px;
    bottom: -1px;
    font-size: 13px;
    -unity-font-definition: url("../Fonts/Nunito-Black.ttf");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--paper);
}

.slot.is-full .slot__count {
    color: var(--coin-deep);
}

.actions {
    flex-direction: row;
    margin-top: 14px;
    margin-right: -8px;
}

.action {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 58px;
    margin-right: 8px;
    padding-left: 8px;
    padding-right: 8px;
    white-space: normal;
}

/*
 * Catalog: a tray of round tokens across the bottom. The band runs the full width: the tabs stand at its
 * left end, the tokens in the middle of the screen, and the status line takes the right end, so the tray
 * keeps clear of both ends.
 */

.bottom {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    min-height: 64px;
    flex-shrink: 0;
}

.catalog {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    padding-left: 300px;
    padding-right: 300px;
    transition-property: translate, opacity;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.catalog.is-closed {
    translate: 0 300px;
    opacity: 0;
}

/* under the orders tray while creatures are selected or the map waits for a pick */
.catalog.is-covered {
    translate: 0 300px;
    opacity: 0;
}

/* The tabs, at the band's left end. */
.catalog__side {
    position: absolute;
    left: 130px;
    bottom: 40px;
    align-items: flex-start;
}

.catalog__side > .tab {
    margin-top: 8px;
    font-size: 20px;
}

.catalog__close {
    margin-top: 12px;
    margin-left: -6px;
}

.catalog__page {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 1;
    max-width: 100%;
}

/* discs line up along the top; a name that takes two lines hangs lower */
.tray {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    flex-shrink: 1;
    max-width: 100%;
}

/* How many creatures one press hires: hangs to the left of the creature tokens, which keep the middle. */
.stepper {
    position: absolute;
    right: 100%;
    bottom: 48px;
    margin-right: 40px;
    align-items: center;
}

.stepper__label {
    font-size: 17px;
    color: var(--ink-soft);
    margin-bottom: 6px;
}

.stepper__row {
    flex-direction: row;
    align-items: center;
}

.stepper__value {
    width: 50px;
    font-size: 30px;
    -unity-text-align: middle-center;
}

/* A thing to build or hire: a round picture with its name and price under it; details in the hint. A token
   keeps its width in a scrolling tray: shrunk, its name breaks letter by letter. */
.token {
    width: 139px;
    flex-shrink: 0;
    align-items: center;
    margin: 0 13px 2px 13px;
}

/* disc.png: the 120 px circle sits in the middle of this box, so the box reaches past the token */
.token__disc {
    width: 160px;
    height: 160px;
    margin: -20px -11px -15px -11px;
    align-items: center;
    justify-content: center;
}

.token__art {
    width: 95px;
    height: 95px;
    margin-top: -5px;
}

.token__monogram {
    font-size: 42px;
    color: var(--ink-soft);
}

/* a creature's portrait is small pixel art: shown larger */
.token--unit .token__art {
    width: 105px;
    height: 105px;
}

.token__name {
    font-size: 17px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.token__price {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 26px;
}

.token__coin {
    width: 24px;
    height: 24px;
    margin-right: 2px;
}

.token__price-value {
    font-size: 18px;
    color: var(--coin-deep);
}

.token.is-short .token__price-value {
    color: var(--bad);
}

.token__lock {
    font-size: 16px;
    color: var(--ink-soft);
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
}

.token.is-locked {
    opacity: 0.55;
}

/* the model preview, on the disc's shoulder while the pointer is over the token */
.token__look {
    position: absolute;
    right: -6px;
    top: -10px;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    display: none;
}

.token:hover .token__look {
    display: flex;
}

.token__look > .glyph {
    width: 24px;
    height: 24px;
}

/* Model preview beside the catalog */

.showcase {
    width: 380px;
    height: 420px;
}

.showcase__header {
    flex-direction: row;
    align-items: center;
}

.showcase__title {
    flex-grow: 1;
    font-size: 22px;
}

.showcase__image {
    flex-grow: 1;
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 16px;
    background-color: var(--paper-soft);
}

.showcase__caption {
    font-size: 15px;
    color: var(--ink-soft);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* The latest word from the colony, at the right end of the bottom band, clear of the version corner. */

.status {
    position: absolute;
    right: -12px;
    bottom: 14px;
    max-width: 320px;
    align-items: flex-end;
    transition-property: opacity;
    transition-duration: 0.8s;
}

.status.is-faded {
    opacity: 0;
}

.status__text {
    font-size: 17px;
    white-space: normal;
    -unity-text-align: upper-right;
}

/*
 * The orders tray (ContextBar): while creatures are selected or the map waits for a pick, the catalog steps
 * down and the orders take its place. The left end says who or what, as the catalog's tabs stand there; the
 * middle holds round tokens like the catalog's; the right end stays clear for the status line.
 */

.orders {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 16px;
    flex-direction: row;
    align-items: flex-end;
}

.orders__side {
    width: 460px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 96px;
    margin-bottom: 34px;
}

/* disc.png's 66 px circle in this 88 box; the picture of who or what sits on it */
.orders__portrait {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    margin: -11px 2px -11px -11px;
    align-items: center;
    justify-content: center;
    background-image: url("../Sprites/disc.png");
}

.orders__portrait-art {
    width: 46px;
    height: 46px;
}

.orders__text {
    flex-shrink: 1;
    align-items: flex-start;
}

.orders__title {
    font-size: 24px;
    white-space: normal;
}

.orders__prompt {
    margin-top: 2px;
    font-size: 16px;
    color: var(--ink-soft);
    white-space: normal;
}

.orders__clear {
    min-height: 30px;
    margin-top: 6px;
    margin-left: -10px;
    padding: 0 10px;
    border-width: 0;
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 15px;
    color: var(--ink-soft);
}

.orders__clear:hover {
    background-color: rgba(255, 255, 255, 0.6);
    color: var(--ink);
}

.orders__middle {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
}

.orders__row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
}

/* the load of one selected hauler: the good and its count, then the coin and its price */
.orders__load {
    flex-direction: row;
    align-items: center;
    align-self: center;
    margin: 0 24px 22px 0;
}

.orders__load-art {
    width: 56px;
    height: 56px;
    margin-right: 4px;
}

.orders__load-text {
    font-size: 26px;
    margin-right: 14px;
}

.orders__end {
    width: 460px;
    flex-shrink: 0;
}

/* a name with its key under the disc */
.orders__name {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* keys as white keycaps, readable over the island */
.orders__key,
.orders__clear .hotkey {
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--paper-line);
    background-color: var(--paper);
    font-size: 13px;
    color: var(--ink);
}

.orders__key {
    margin-top: 6px;
}

.orders .token__disc > .glyph {
    width: 44px;
    height: 44px;
}

.orders__coin-art {
    width: 72px;
    height: 72px;
}

/* the main orders: a roof-blue disc with a white glyph, as in the tools */
.orders .btn-disc.is-primary,
.fan .btn-disc.is-primary {
    -unity-background-image-tint-color: var(--accent);
}

.orders .btn-disc.is-primary > .glyph,
.fan .btn-disc.is-primary > .glyph {
    -unity-background-image-tint-color: var(--paper);
}

/* the quest's next order still breathes, blue or not */
.orders .btn-disc.is-primary.is-suggested {
    -unity-background-image-tint-color: var(--accent-soft);
}

.hud-pulse .orders .btn-disc.is-primary.is-suggested {
    -unity-background-image-tint-color: var(--accent-pulse);
}

.orders .btn-disc.is-primary.is-suggested > .glyph {
    -unity-background-image-tint-color: var(--accent-deep);
}

/*
 * Right-click orders (CommandFan): an arc of three round buttons over the click; the key's letter on each
 * rim, the name and meaning in the hint.
 */

.fan {
    position: absolute;
    width: 0;
    height: 0;
}

/* left/top come from code and mark the button's centre; disc.png's 60 px circle in this 80 box */
.fan__disc {
    position: absolute;
    translate: -50% -50%;
    width: 80px;
    height: 80px;
}

.fan__disc > .glyph {
    width: 28px;
    height: 28px;
}

.fan__key {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 1px 6px;
    border-radius: 7px;
    background-color: var(--paper);
    border-width: 1px;
    border-color: var(--paper-line);
    font-size: 13px;
    color: var(--ink);
}

/* What a haul order carries: a dialog in the middle of the screen, a card per good */

.cargo-dialog {
    width: 660px;
    max-width: 94%;
    align-items: stretch;
}

.cargo-dialog__title {
    font-size: 25px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.cargo-dialog__text {
    margin-top: 4px;
    margin-bottom: 14px;
    font-size: 16px;
    color: var(--ink-soft);
    white-space: normal;
    -unity-text-align: middle-center;
}

.cargo-dialog__choices {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.cargo-card {
    flex-direction: column;
    width: 138px;
    min-height: 136px;
    margin: 5px;
    padding: 10px 8px 8px 8px;
    border-radius: 20px;
}

.cargo-card__art {
    flex-direction: row;
    height: 58px;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.cargo-card__icon {
    width: 58px;
    height: 58px;
}

.cargo-card__stack-icon {
    width: 38px;
    height: 38px;
    margin-left: -8px;
    margin-right: -8px;
}

.cargo-card__letter {
    font-size: 26px;
    -unity-text-align: middle-center;
}

.cargo-card__name {
    font-size: 16px;
    white-space: normal;
}

.cargo-card__sub {
    margin-top: 2px;
    font-size: 13px;
    color: var(--ink-soft);
    -unity-text-align: middle-center;
}

.cargo-dialog__note {
    margin-top: 10px;
    font-size: 15px;
    color: var(--ink-soft);
    white-space: normal;
    -unity-text-align: middle-center;
}

.cargo-dialog__actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
}

.cargo-dialog__actions .btn {
    min-width: 180px;
    margin-left: 6px;
    margin-right: 6px;
}

/* Workers and haulers of the inspected building */

.staff-scroll {
    max-height: 250px;
    margin-top: 10px;
    flex-shrink: 1;
}

.staff {
    margin-bottom: 8px;
}

.staff__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

/* A group's arrow, icons and caption: one button that opens and folds its rows. */
.staff__toggle {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: flex-start;
    min-height: 32px;
    margin-right: 6px;
    padding: 0 8px 0 4px;
    border-radius: 16px;
}

.staff__chevron {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.staff.is-collapsed .staff__chevron {
    rotate: 180deg;
}

.staff__icons {
    flex-direction: row;
    flex-shrink: 0;
    margin-right: 6px;
}

.staff__icon {
    width: 24px;
    height: 24px;
    margin-right: 2px;
}

.staff__caption {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.staff__all {
    min-height: 32px;
    padding: 0 12px;
    font-size: 14px;
}

.staff__empty {
    margin-top: 0;
    font-size: 15px;
}

.staff-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 4px 4px 4px 8px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.7);
}

.staff-row__portrait {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 8px;
}

.staff-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.staff-row__name {
    font-size: 15px;
}

.staff-row__state {
    font-size: 13px;
    color: var(--ink-soft);
    white-space: normal;
}

.staff-row__release {
    width: 30px;
    height: 30px;
    min-height: 30px;
    font-size: 18px;
}

/* colony upgrades in the guild's and the barracks' card: one row each, the price on a button */
.upgrades {
    flex-direction: column;
    margin-top: 6px;
}

.upgrade {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.upgrade__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 8px;
}

.upgrade__title {
    font-size: 17px;
}

.upgrade__info {
    font-size: 14px;
    white-space: normal;
}

.upgrade__buy {
    flex-shrink: 0;
    min-width: 96px;
    height: 38px;
    font-size: 15px;
}

/* The left column: the quest keeps its height, the inspect card below it shrinks (and its quest folds). */
.col-fixed {
    flex-shrink: 0;
}

.col-flex {
    flex-shrink: 1;
    min-height: 0;
}

/*
 * Catalog pages (CatalogPager): a row of whole tokens, round arrows hanging at its ends in the band's clear
 * ends, a dot per page over the row. The arrow towards the quest's page wears an accent pip.
 */
.catalog-pager {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.catalog-arrow {
    position: absolute;
    top: 30px;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
}

.catalog-arrow--prev {
    right: 100%;
    margin-right: 4px;
}

.catalog-arrow--next {
    left: 100%;
    margin-left: 4px;
}

.catalog-arrow__glyph {
    width: 24px;
    height: 24px;
}

.catalog-arrow--prev > .catalog-arrow__glyph {
    rotate: -90deg;
}

.catalog-arrow--next > .catalog-arrow__glyph {
    rotate: 90deg;
}

.catalog-arrow__pip {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: var(--paper);
    background-color: var(--accent);
}

.catalog-dots {
    position: absolute;
    left: 0;
    right: 0;
    top: -22px;
    flex-direction: row;
    justify-content: center;
}

.catalog-dot {
    width: 10px;
    height: 10px;
    margin: 0 4px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 1px;
    border-color: var(--paper-line);
}

.catalog-dot.is-on {
    background-color: var(--ink);
    border-color: var(--ink);
}

.catalog-dot.is-quest {
    background-color: var(--accent);
    border-color: var(--accent);
}

/* the hire stepper steps aside for the page arrow */
.stepper.stepper--paged {
    margin-right: 108px;
}

/* Catalog trays: one row of tokens that scrolls sideways when the band is too narrow. */
.tray-scroll {
    flex-shrink: 1;
    max-width: 100%;
}

.tray--row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
}

/*
 * Arena poster (ArenaPanel): the ladder as a rail of level discs on the left, the chosen level on the right.
 * The rail scrolls when the ladder outgrows the sheet; the poster keeps its place.
 */
.arena-dialog {
    flex-direction: row;
    width: 900px;
    max-width: 94%;
    max-height: 90%;
    padding: 40px 48px 54px 36px;
}

/* the poster sets the sheet's height; the rail fills it and scrolls, so a long ladder leaves no blank sheet */
.arena-rail {
    width: 100px;
    flex-shrink: 0;
}

.arena-rail__scroll {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.arena-rail__scroll .unity-scroll-view__content-container {
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
}

.arena-rail__level {
    align-items: center;
}

.arena-rail__path {
    align-items: center;
    padding-top: 2px;
    padding-bottom: 2px;
}

.arena-rail__dot {
    width: 6px;
    height: 6px;
    margin-top: 3px;
    margin-bottom: 3px;
    border-radius: 3px;
    background-color: var(--paper-line);
}

.arena-rail__level.is-closed .arena-rail__path {
    opacity: 0.5;
}

/* disc.png: a 57 px circle in this box */
.arena-rail__disc {
    width: 76px;
    height: 76px;
}

.arena-rail__disc > .btn__caption {
    font-size: 24px;
}

.arena-rail__level.is-closed .arena-rail__disc > .btn__caption {
    color: var(--ink-faint);
}

.arena-rail__level .arena-rail__disc.is-on > .btn__caption {
    color: var(--paper);
}

/* a tick on a won level, a lock on the closed one, on the disc's upper right */
.arena-rail__badge {
    position: absolute;
    top: 6px;
    right: 4px;
    width: 24px;
    height: 24px;
    border-width: 2px;
    border-color: var(--paper);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
}

.arena-rail__badge--won {
    background-color: var(--good-fill);
}

.arena-rail__badge--closed {
    background-color: var(--ink-faint);
}

.arena-rail__badge > .glyph {
    width: 13px;
    height: 13px;
    -unity-background-image-tint-color: var(--paper);
}

.arena-rail__rest {
    flex-direction: row;
    align-items: center;
    margin-top: -6px;
}

.arena-rail__rest > .glyph {
    width: 14px;
    height: 14px;
    margin-right: 3px;
    -unity-background-image-tint-color: var(--ink-soft);
}

.arena-rail__rest-time {
    font-size: 13px;
    color: var(--ink-soft);
}

.arena-dialog__rule {
    width: 1px;
    flex-shrink: 0;
    margin: 4px 0;
    background-color: var(--paper-line);
}

.arena-poster {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding-left: 28px;
}

.arena-poster__head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 14px;
}

.arena-poster__titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.arena-poster__eyebrow {
    font-size: 15px;
    color: var(--ink-soft);
}

.arena-poster__name {
    font-size: 32px;
    white-space: normal;
}

/* your squad's places against the enemy, as they stand on the board; both captions on one line */
.arena-lineup {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    padding: 14px 20px 14px 22px;
    margin-bottom: 18px;
    border-radius: 22px;
    background-color: var(--paper-soft);
}

.arena-lineup__side--enemy {
    align-items: flex-end;
}

.arena-lineup__caption {
    font-size: 15px;
    color: var(--ink-soft);
    margin-bottom: 8px;
}

/* the rows fill the height under the captions and centre on each other */
.arena-lineup__row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

/* four places to a row */
.arena-squad {
    flex-wrap: wrap;
    align-content: center;
    width: 184px;
}

.arena-slot {
    width: 40px;
    height: 40px;
    margin: 0 6px 6px 0;
    border-width: 2px;
    border-color: var(--paper-line);
    border-radius: 20px;
}

/* level with the rows: pushed down by the captions' height */
.arena-lineup__versus {
    align-self: center;
    width: 34px;
    height: 34px;
    margin: 31px 10px 0 10px;
    -unity-background-image-tint-color: var(--ink-faint);
}

.arena-foe {
    align-items: center;
    margin-left: 2px;
}

/* disc.png: a 72 px circle in this box */
.arena-foe__disc {
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
    background-image: url("../Sprites/disc.png");
}

.arena-foe__art {
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: scale-to-fit;
}

.arena-foe__count {
    margin-top: -22px;
    padding: 0 9px;
    border-radius: 11px;
    background-color: var(--ink);
    color: var(--paper);
    font-size: 15px;
}

.arena-facts {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

/* a picture, its number or name, and a line on what it means */
.arena-fact {
    flex-direction: row;
    align-items: center;
    margin-right: 36px;
    margin-bottom: 4px;
}

.arena-fact__coin {
    width: 40px;
    height: 40px;
    margin-right: 10px;
}

.arena-fact__ring {
    width: 44px;
    height: 44px;
    margin-right: 10px;
    border-width: 3px;
    border-color: var(--accent);
    border-radius: 22px;
    background-color: var(--accent-soft);
    align-items: center;
    justify-content: center;
}

.arena-fact__art {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

.arena-fact__value {
    font-size: 18px;
}

.arena-fact__value--gold {
    font-size: 24px;
    color: var(--coin-deep);
}

.arena-fact__value--hire {
    color: var(--accent-deep);
}

.arena-fact__note {
    font-size: 14px;
    color: var(--ink-soft);
}

.arena-poster__foot {
    flex-direction: row;
    align-items: center;
}

.arena-poster__picture {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 8px;
}

.arena-poster__glyph {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    -unity-background-image-tint-color: var(--ink-soft);
}

.arena-poster__state {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
    font-size: 15px;
    color: var(--ink-soft);
    white-space: normal;
}

.arena-poster__fight {
    min-width: 200px;
    min-height: 56px;
    border-radius: 28px;
    font-size: 19px;
}

/* Pause menu: the first page on the halo over the island, the others on a sheet with a back arrow */
.menu-pause {
    align-items: center;
    margin-top: -40px;
}

.menu-pause__title {
    font-size: 64px;
}

.menu-pause__note {
    margin-top: 2px;
    font-size: 19px;
}

/* room above the discs for a hint card, so it never covers the title */
.menu-pause__actions {
    flex-direction: row;
    margin-top: 100px;
}

.pause-action {
    align-items: center;
    width: 172px;
}

/* disc.png: the 102 px circle sits in the middle of this box */
.pause-action__disc {
    width: 136px;
    height: 136px;
}

.pause-action__disc > .glyph {
    width: 40px;
    height: 40px;
}

.pause-action__caption {
    margin-top: -10px;
    font-size: 19px;
}

.menu-dialog {
    width: 580px;
    max-width: 94%;
}

.menu-dialog__title {
    flex-grow: 1;
    margin-left: 10px;
    font-size: 30px;
}

.menu-page {
    flex-direction: column;
    align-items: stretch;
}

.menu-caption {
    margin-top: 4px;
    margin-bottom: 2px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
}

.setting-row__glyph {
    width: 22px;
    height: 22px;
    margin-right: 14px;
}

/* a longer word in another language pushes its control instead of running under it */
.setting-row__label {
    min-width: 104px;
    margin-right: 8px;
    flex-shrink: 0;
    font-size: 17px;
}

.setting-row__control {
    flex-grow: 1;
    flex-shrink: 1;
}

.setting-row__value {
    width: 44px;
    flex-shrink: 0;
    font-size: 16px;
    -unity-text-align: middle-right;
}

/* under the graphics choices, from where they start */
.setting-note {
    margin: 0 0 4px 148px;
    font-size: 14px;
    white-space: normal;
}

.language-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.language-choice {
    width: 32.5%;
    margin-bottom: 8px;
    padding: 0 8px;
}

.menu-text {
    margin-bottom: 12px;
    font-size: 16px;
    white-space: normal;
}

.menu-help {
    margin-bottom: 10px;
}

.menu-note {
    margin-bottom: 8px;
    font-size: 14px;
    white-space: normal;
}

.menu-version {
    margin-top: 12px;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.menu-buttons {
    flex-direction: row;
    margin-top: 18px;
}

.menu-buttons__button {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 52px;
    margin: 0 5px;
}

/* The notice that opens a new version: what this build is on the left, the community on the right */
.intro-dialog {
    width: 900px;
    max-width: 94%;
    flex-direction: row;
    align-items: stretch;
}

.intro-dialog__main {
    flex-grow: 1;
    flex-shrink: 1;
    padding-right: 26px;
}

.intro-dialog__heading {
    flex-direction: row;
    align-items: center;
}

.intro-dialog__title {
    margin-right: 12px;
    font-size: 36px;
}

.intro-dialog__text {
    margin-top: 12px;
    font-size: 17px;
    white-space: normal;
}

.intro-dialog__help {
    margin-top: 14px;
}

.intro-dialog__note {
    margin-top: 18px;
    font-size: 14px;
    white-space: normal;
}

.intro-dialog__actions {
    flex-direction: row;
    margin-top: 10px;
}

.intro-play {
    min-width: 220px;
    min-height: 54px;
    margin-right: 12px;
}

.intro-steam {
    min-height: 54px;
}

.intro-steam__glyph {
    width: 18px;
    height: 18px;
    margin-right: 10px;
}

.intro-dialog__side {
    width: 280px;
    flex-shrink: 0;
    padding: 18px 16px;
}

.link-rows > .link-row {
    margin-top: 8px;
}

.rotate-dialog {
    width: 80%;
    align-items: center;
}

.rotate-dialog__title {
    font-size: 36px;
}

.rotate-dialog__text {
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}
