/*
 * HUD theme shared by every screen: colours, type and the building blocks.
 *
 * The look is "air": the island stays in view and the HUD barely has chrome. Text over the world is dark
 * ink with a white halo, on a soft patch of mist where it runs to several lines (.float). White sheets
 * with a soft shadow are kept for what floats above the game and must be read at once: dialogs, the
 * hint card, the order prompt. Buttons are white pills; the one accent is the blue of the island's
 * roofs, and coin gold marks spending and rewards. Screens add layout and sizes only, and use these
 * variables instead of their own colours.
 */

:root {
    --ink: #1E2A40;
    --ink-soft: #3E4C64;
    --ink-faint: #7C889C;
    --paper: #FFFFFF;
    --paper-soft: #F2F6FB;
    --paper-line: rgba(30, 42, 64, 0.14);
    --halo: rgba(255, 255, 255, 0.95);
    --accent: #2F5BAE;
    --accent-hover: #3B6BC4;
    --accent-deep: #1F4488;
    --accent-soft: #E1EAF9;
    --accent-pulse: #C4D6F5;
    --good: #3A7715;
    --good-fill: #6FAE35;
    --warn: #935700;
    --bad: #B83624;
    --bad-soft: #FBE6E1;
    --coin: #F6C343;
    --coin-hover: #FFD263;
    --coin-deep: #8F6200;
    /* the enchanter's violet: enchanted items, never a second accent */
    --magic: #8E5BE0;
    --veil: rgba(228, 236, 245, 0.45);
    --veil-deep: rgba(220, 230, 241, 0.72);
}

/* Root of the screen UI document: type and text colour inherit from here into every nested document. */
.ui-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("../Fonts/Nunito-SemiBold.ttf");
    font-size: 18px;
    color: var(--ink);
}

/* A nested document that covers its parent: a screen, an overlay, a layer that positions its own content. */
.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.t-medium {
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
}

.t-bold {
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
}

.t-black {
    -unity-font-definition: url("../Fonts/Nunito-Black.ttf");
}

/* A short label over what it names: sentence case, never spaced out. */
.t-caption {
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
    font-size: 15px;
    color: var(--ink-soft);
}

.t-muted {
    color: var(--ink-soft);
}

.t-gold {
    color: var(--coin-deep);
}

.t-good {
    color: var(--good);
}

.t-warn {
    color: var(--warn);
}

.t-bad {
    color: var(--bad);
}

.t-wrap {
    white-space: normal;
}

.spacer {
    flex-grow: 1;
}

/*
 * Text standing on the world: a soft white glow keeps dark ink readable over grass, roofs and clouds. A text
 * outline would eat into the letters and leave small text thin and grey, so the glow is a shadow.
 */
.halo,
.float {
    text-shadow: 0 0 5px var(--halo);
}

/* A block of text on the world: a patch of mist with no edge behind it, wider than the text. */
.float {
    background-image: url("../Sprites/mist.png");
    -unity-slice-left: 60;
    -unity-slice-right: 60;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    padding: 18px 24px;
}

/* A patch of mist hugging one line or paragraph of text, for small text over a busy world. */
.float--tight {
    background-image: url("../Sprites/mist.png");
    -unity-slice-left: 60;
    -unity-slice-right: 60;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    -unity-slice-scale: 0.4px;
    align-self: flex-start;
    padding: 4px 14px;
    margin-left: -14px;
    margin-right: -14px;
}

/*
 * A white sheet floating above the game, with its shadow drawn into the picture. The picture reaches
 * past the sheet (28 px left and right, 22 above, 36 below); the margins give that back to the layout
 * and the padding keeps content off the shadow.
 */
.sheet {
    background-image: url("../Sprites/sheet.png");
    -unity-slice-left: 50;
    -unity-slice-right: 50;
    -unity-slice-top: 44;
    -unity-slice-bottom: 58;
    margin: -22px -28px -36px -28px;
    padding: 38px 46px 50px 46px;
}

.divider {
    height: 1px;
    flex-shrink: 0;
    background-color: var(--paper-line);
    margin-top: 10px;
    margin-bottom: 10px;
}

/*
 * Buttons: white pills with a hairline, so they hold their edge over clouds too. The hover lift and press
 * dip are transitions; UiFeel adds sound and the refusal wobble. Buttons never wear the halo.
 */
.btn {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    background-color: var(--paper);
    border-width: 2px;
    border-color: var(--paper-line);
    border-radius: 24px;
    color: var(--ink);
    font-size: 17px;
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
    -unity-text-align: middle-center;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    white-space: nowrap;
    transition-property: scale, background-color, opacity, border-color;
    transition-duration: 0.12s, 0.12s, 0.2s, 0.3s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.btn:hover {
    background-color: var(--paper-soft);
    border-color: rgba(47, 91, 174, 0.35);
    scale: 1.03 1.03;
}

.btn:active {
    scale: 0.96 0.96;
}

.btn--primary {
    background-color: var(--accent);
    border-color: var(--accent-deep);
    color: var(--paper);
}

.btn--primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-deep);
}

/* Spending and taking gold: the coin's colour. */
.btn--gold {
    background-color: var(--coin);
    border-color: rgba(143, 98, 0, 0.45);
    color: var(--ink);
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
}

.btn--gold:hover {
    background-color: var(--coin-hover);
    border-color: rgba(143, 98, 0, 0.6);
}

.btn--danger {
    color: var(--bad);
    border-color: rgba(184, 54, 36, 0.3);
}

.btn--danger:hover {
    background-color: var(--bad-soft);
    border-color: rgba(184, 54, 36, 0.5);
}

/* A switch that is on, a tab or a choice that is taken. */
.btn.is-on {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-deep);
}

.btn.is-unavailable {
    opacity: 0.45;
}

.btn.is-unavailable:hover {
    scale: 1 1;
}

/* What the current quest asks for next. The HUD toggles .hud-pulse on its root so the rim breathes. */
.btn.is-suggested {
    border-color: var(--accent);
}

.hud-pulse .btn.is-suggested {
    border-color: var(--accent-hover);
    background-color: var(--accent-soft);
}

.hud-pulse .btn--primary.is-suggested,
.hud-pulse .btn--gold.is-suggested {
    border-color: var(--ink);
}

.btn-icon {
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 20px;
    font-size: 24px;
}

.btn-close {
    width: 36px;
    height: 36px;
    min-height: 36px;
    padding: 0;
    border-radius: 18px;
    font-size: 22px;
    color: var(--ink-soft);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.btn-close:hover {
    background-color: var(--paper-soft);
    border-color: var(--paper-line);
}

/* A heading on a card that folds what is under it: no pill until hovered, and it does not grow, being wide. */
.btn-flat {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.btn-flat:hover {
    background-color: var(--paper-soft);
    border-color: var(--paper-line);
    scale: 1 1;
}

/* A button that is a word on the world: accent ink with the halo and no pill; hovered, a soft pill shows under it. */
.btn-link {
    min-height: 0;
    padding: 2px 10px 2px 6px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    border-radius: 14px;
    color: var(--accent);
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
    text-shadow: 0 0 5px var(--halo);
}

.btn-link:hover {
    background-color: rgba(225, 234, 249, 0.9);
    border-color: rgba(0, 0, 0, 0);
    color: var(--accent-deep);
}

.btn-link > .glyph {
    -unity-background-image-tint-color: var(--accent);
}

.btn-link:hover > .glyph {
    -unity-background-image-tint-color: var(--accent-deep);
}

/*
 * A round white button with its shadow drawn into the picture (disc.png: a 240 px circle in 320 px).
 * Set width and height to 4/3 of the circle; the tint recolours the circle for states.
 */
.btn-disc {
    padding: 0;
    min-height: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Sprites/disc.png");
    -unity-background-image-tint-color: var(--paper);
    transition-property: scale, opacity, -unity-background-image-tint-color;
    transition-duration: 0.12s, 0.2s, 0.3s;
}

.btn-disc:hover {
    background-color: rgba(0, 0, 0, 0);
    scale: 1.06 1.06;
}

.btn-disc.is-on {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--accent);
    color: var(--paper);
}

.btn-disc.is-suggested {
    -unity-background-image-tint-color: var(--accent-soft);
}

.hud-pulse .btn-disc.is-suggested {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--accent-pulse);
}

/* One-colour pictograms, white in the file and tinted here. */
.glyph {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--ink);
}

.is-on > .glyph {
    -unity-background-image-tint-color: var(--paper);
}

.is-suggested > .glyph {
    -unity-background-image-tint-color: var(--accent-deep);
}

.glyph--idle {
    background-image: url("../Icons/idle.svg");
}

.glyph--land {
    background-image: url("../Icons/land.svg");
}

.glyph--grid {
    background-image: url("../Icons/grid.svg");
}

.glyph--battle {
    background-image: url("../Icons/battle.svg");
}

.glyph--catalog {
    background-image: url("../Icons/catalog.svg");
}

.glyph--look {
    background-image: url("../Icons/look.svg");
}

.glyph--auto {
    background-image: url("../Icons/auto.svg");
}

.glyph--work {
    background-image: url("../Icons/work.svg");
}

.glyph--haul {
    background-image: url("../Icons/haul.svg");
}

.glyph--free {
    background-image: url("../Icons/free.svg");
}

.glyph--cancel {
    background-image: url("../Icons/cancel.svg");
}

.glyph--pause {
    background-image: url("../Icons/pause.svg");
}

.glyph--play {
    background-image: url("../Icons/play.svg");
}

.glyph--health {
    background-image: url("../Icons/health.svg");
}

.glyph--damage {
    background-image: url("../Icons/damage.svg");
}

.glyph--armor {
    background-image: url("../Icons/armor.svg");
}

.glyph--helmet {
    background-image: url("../Icons/helmet.svg");
}

.glyph--book {
    background-image: url("../Icons/book.svg");
}

.glyph--check {
    background-image: url("../Icons/check.svg");
}

.glyph--lock {
    background-image: url("../Icons/lock.svg");
}

.glyph--rest {
    background-image: url("../Icons/rest.svg");
}

.glyph--star {
    background-image: url("../Icons/star.svg");
}

/*
 * An arrow pointing up: "fold". Turned over, it points down: "unfold".
 * The SVG imports cropped to the stroke (wider than tall), so it fits its square box instead of stretching.
 */
.glyph--chevron {
    background-image: url("../Icons/chevron.svg");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: rotate;
    transition-duration: 0.2s;
}

/* Caption of a button that also carries a badge; inherits the button's type. */
.btn__caption {
    -unity-text-align: middle-center;
}

/* Two-line button: what it does, then its price or hint. */
.btn-stack {
    flex-direction: column;
    border-radius: 18px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.btn__title {
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
    font-size: 16px;
    -unity-text-align: middle-center;
}

.btn__hint {
    font-size: 13px;
    color: var(--ink-soft);
    -unity-text-align: middle-center;
}

.btn--primary .btn__hint {
    color: rgba(255, 255, 255, 0.85);
}

.btn--gold .btn__hint {
    color: var(--ink);
}

.btn--danger .btn__hint {
    color: var(--bad);
}

.btn.is-unavailable .btn__hint {
    color: var(--bad);
}

.btn--primary.is-unavailable .btn__hint {
    color: var(--paper);
}

/* The key for a command, as a small keycap after its caption. */
.hotkey {
    margin-left: 8px;
    padding: 1px 6px;
    border-radius: 6px;
    background-color: rgba(30, 42, 64, 0.08);
    font-size: 12px;
    color: var(--ink-soft);
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
}

.btn--primary .hotkey {
    background-color: rgba(255, 255, 255, 0.2);
    color: var(--paper);
}

/* A text tab: the taken one is ink with a line under it. */
.tab {
    flex-direction: row;
    align-items: center;
    padding: 4px 2px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--ink-soft);
    font-size: 18px;
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
    transition-property: border-color, color;
    transition-duration: 0.15s, 0.15s;
}

.tab:hover {
    color: var(--ink);
}

.tab.is-active {
    color: var(--ink);
    border-color: var(--ink);
}

.tab.is-suggested {
    color: var(--accent);
}

.hud-pulse .tab.is-suggested {
    border-color: var(--accent-pulse);
}

/* Key and value rows. */
.kv {
    flex-direction: row;
    padding-top: 3px;
    padding-bottom: 3px;
}

.kv__key {
    width: 40%;
    flex-shrink: 0;
    font-size: 16px;
    color: var(--ink-soft);
}

.kv__value {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 16px;
    -unity-font-definition: url("../Fonts/Nunito-Bold.ttf");
    white-space: normal;
}

.note {
    margin-top: 6px;
    font-size: 15px;
    color: var(--ink-soft);
    white-space: normal;
}

/*
 * Built-in controls. The game theme does not import Unity's default one, so the structure a ScrollView
 * needs to clip and scroll its content is declared here.
 */
.unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.unity-scroll-view__content-container {
    flex-shrink: 0;
}

/* A creature's side in a battle, in the board's colours: blue under yours, red under the enemy. */
.side-ours {
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.side-enemy {
    border-color: var(--bad);
    background-color: var(--bad-soft);
}

/*
 * Hint card by the element under the pointer. left/top from HudTooltip mark the anchor of the card's
 * picture, shadow included; the side class says which way the card opens from it.
 */

.tooltip {
    position: absolute;
    margin: 0;
    translate: -50% -100%;
    max-width: 420px;
    flex-direction: row;
    align-items: flex-start;
}

.tooltip--below {
    translate: 0 0;
}

.tooltip--left {
    translate: -100% -50%;
}

.tooltip__text {
    flex-shrink: 1;
}

.tooltip__title {
    font-size: 17px;
}

.tooltip__body {
    margin-top: 3px;
    font-size: 15px;
    color: var(--ink-soft);
    white-space: normal;
}

.tooltip__key {
    margin-left: 12px;
    margin-top: 1px;
    padding: 3px 9px;
    font-size: 15px;
}

/* A hint whose thing has a page in the book says so in the accent, with the book's key. */
.tooltip__more {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.tooltip__more-text {
    font-size: 15px;
    color: var(--accent);
}

/* Behind a dialog the island stays in view, blurred under a pale veil. */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--veil);
    backdrop-filter: blur(6px);
}

/* A quick choice in the middle of an order: the map stays sharp. */
.overlay--soft {
    backdrop-filter: none;
}

/* A moment that should hold the whole screen, such as a reward. */
.overlay--deep {
    background-color: var(--veil-deep);
    backdrop-filter: blur(10px);
}

.dialog {
    width: 580px;
}

.dialog__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.dialog__title {
    flex-grow: 1;
    font-size: 26px;
}

/* A title followed by its key: the title keeps its width and a spacer pushes the close button out. */
.dialog__title--fit {
    flex-grow: 0;
}

.dialog__text {
    font-size: 17px;
    color: var(--ink-soft);
    white-space: normal;
    margin-bottom: 14px;
}

.dialog .btn {
    margin-bottom: 10px;
    min-height: 52px;
}

.glyph--menu {
    background-image: url("../Icons/menu.svg");
}

/* Devanagari needs shaping: the advanced text generator for Hindi (Localization) */
.lang-complex {
    -unity-text-generator: advanced;
}

/* Pictograms of the menu, the settings and the links */
.glyph--settings {
    background-image: url("../Icons/settings.svg");
}

.glyph--info {
    background-image: url("../Icons/info.svg");
}

.glyph--restart {
    background-image: url("../Icons/restart.svg");
}

.glyph--music {
    background-image: url("../Icons/music.svg");
}

.glyph--sound {
    background-image: url("../Icons/sound.svg");
}

.glyph--nature {
    background-image: url("../Icons/nature.svg");
}

.glyph--graphics {
    background-image: url("../Icons/graphics.svg");
}

.glyph--text-size {
    background-image: url("../Icons/text-size.svg");
}

.glyph--language {
    background-image: url("../Icons/language.svg");
}

.glyph--telegram {
    background-image: url("../Icons/telegram.svg");
}

.glyph--youtube {
    background-image: url("../Icons/youtube.svg");
}

.glyph--discord {
    background-image: url("../Icons/discord.svg");
}

.glyph--players {
    background-image: url("../Icons/players.svg");
}

.glyph--mail {
    background-image: url("../Icons/mail.svg");
}

.glyph--external {
    background-image: url("../Icons/external.svg");
}

.glyph--heart {
    background-image: url("../Icons/heart.svg");
}

.glyph--muted {
    -unity-background-image-tint-color: var(--ink-soft);
}

.t-faint {
    color: var(--ink-faint);
}

/* A round button that leads (roof blue, white glyph) or warns (red glyph). */
.btn-disc.is-primary {
    -unity-background-image-tint-color: var(--accent);
}

.btn-disc.is-primary > .glyph {
    -unity-background-image-tint-color: var(--paper);
}

.btn-disc.is-danger > .glyph {
    -unity-background-image-tint-color: var(--bad);
}

/* A round button's key as a keycap on its rim. */
.disc-key {
    position: absolute;
    right: 12%;
    bottom: 14%;
    padding: 1px 7px;
    border-radius: 7px;
    background-color: var(--paper);
    border-width: 1px;
    border-color: var(--paper-line);
    font-size: 13px;
    color: var(--ink-soft);
}

/* A key named in a sentence: a white keycap with a deeper bottom edge. */
.keycap {
    flex-shrink: 0;
    padding: 0 8px;
    border-radius: 7px;
    background-color: var(--paper);
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: var(--paper-line);
    font-size: 14px;
    color: var(--ink);
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
}

/* The back arrow at the start of a sheet's header: the chevron turned to the left on a soft disc. */
.btn-back {
    background-color: var(--paper-soft);
}

.btn-back > .glyph {
    width: 18px;
    height: 18px;
    rotate: -90deg;
    -unity-background-image-tint-color: var(--ink-soft);
}

/* A soft panel inside a sheet. */
.panel-soft {
    background-color: var(--paper-soft);
    border-radius: 20px;
}

/* A line with a keycap or a picture before its text, on a soft panel; red for a warning. */
.callout {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-radius: 16px;
    background-color: var(--paper-soft);
}

.callout__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
    font-size: 15px;
    white-space: normal;
}

.callout__glyph {
    width: 26px;
    height: 26px;
}

.callout--danger {
    background-color: var(--bad-soft);
}

.callout--danger > .callout__glyph {
    -unity-background-image-tint-color: var(--bad);
}

/* A short fact beside a title, such as the version. */
.chip {
    padding: 2px 10px;
    border-radius: 14px;
    background-color: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 15px;
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
}

/*
 * Unity's slider. The game imports no Unity theme, so its parts are drawn here: a soft track with the
 * filled share in roof blue (slider__fill, added by code: the dragger only moves) and a white knob.
 */
.slider {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.slider .unity-base-field__input {
    flex-grow: 1;
}

.slider .unity-base-slider__drag-container {
    flex-grow: 1;
    height: 32px;
}

.slider .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--accent-soft);
    overflow: hidden;
}

.slider__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--accent);
}

.slider .unity-base-slider__dragger {
    position: absolute;
    top: 4px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--accent);
    background-color: var(--paper);
    transition-property: scale;
    transition-duration: 0.12s;
}

.slider:hover .unity-base-slider__dragger {
    scale: 1.12 1.12;
}

.slider .unity-base-slider__dragger-border {
    display: none;
}

/* A row of choices in one soft track; the taken one wears the accent like a switch that is on. */
.segmented {
    flex-direction: row;
    padding: 4px;
    border-radius: 22px;
    background-color: var(--paper-soft);
}

.segmented > .btn {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 36px;
    height: 36px;
    margin: 0 1px;
    padding: 0 6px;
    border-radius: 18px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-soft);
    font-size: 15px;
}

.segmented > .btn:hover {
    background-color: var(--paper);
    border-color: rgba(0, 0, 0, 0);
    scale: 1 1;
}

.segmented > .btn.is-on {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-deep);
    -unity-font-definition: url("../Fonts/Nunito-ExtraBold.ttf");
}

/* Sizes shown as the letter A growing. */
.segmented > .segmented__letter {
    -unity-font-definition: url("../Fonts/Nunito-Black.ttf");
}

.segmented > .segmented__letter--1 {
    font-size: 14px;
}

.segmented > .segmented__letter--2 {
    font-size: 18px;
}

.segmented > .segmented__letter--3 {
    font-size: 23px;
}

/* A button that opens a list: the choice on the left, a chevron turned right on the right. */
.btn-picker {
    justify-content: space-between;
    min-height: 44px;
    height: 44px;
    padding: 0 14px 0 18px;
    border-radius: 22px;
    font-size: 16px;
}

.btn-picker:hover {
    scale: 1 1;
}

.btn-picker__chevron {
    width: 18px;
    height: 18px;
    rotate: 90deg;
    -unity-background-image-tint-color: var(--ink-soft);
}

/* Links: round buttons with the name under them, or rows with a picture, the name and an arrow out. */
.link-discs {
    flex-direction: row;
    justify-content: space-between;
}

.link-disc {
    align-items: center;
    width: 92px;
}

/* disc.png: the 57 px circle sits in the middle of this box */
.link-disc__button {
    width: 76px;
    height: 76px;
}

.link-disc__button > .glyph {
    width: 26px;
    height: 26px;
}

.link-disc__caption {
    margin-top: -6px;
    font-size: 14px;
}

.link-row {
    justify-content: flex-start;
    min-height: 44px;
    height: 44px;
    padding: 0 12px 0 6px;
    border-radius: 16px;
}

.link-row:hover {
    scale: 1.02 1.02;
}

.link-row__icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 16px;
    background-color: var(--accent-soft);
    align-items: center;
    justify-content: center;
}

.link-row__icon > .glyph {
    width: 18px;
    height: 18px;
    -unity-background-image-tint-color: var(--accent-deep);
}

.link-row > .btn__caption {
    flex-grow: 1;
    font-size: 16px;
    -unity-text-align: middle-left;
}

.link-row__out {
    width: 16px;
    height: 16px;
    -unity-background-image-tint-color: var(--ink-faint);
}
