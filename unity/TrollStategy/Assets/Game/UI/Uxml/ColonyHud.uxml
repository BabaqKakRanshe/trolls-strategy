<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../Styles/Theme.uss" />
    <ui:Style src="../Styles/ColonyHud.uss" />
    <ui:Style src="../Styles/Progression.uss" />
    <ui:VisualElement name="hud-screen" class="hud-screen" picking-mode="Ignore">
        <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
            <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
                <ui:VisualElement name="brand" class="panel brand">
                    <ui:Label text="ПОСЕЛЕНИЕ" class="brand__title t-bold" />
                    <ui:Label text="ЛЕСНАЯ ДОЛИНА" class="brand__subtitle t-medium" />
                </ui:VisualElement>
                <ui:VisualElement name="resources" class="panel resources">
                    <ui:VisualElement class="stat stat--gold">
                        <ui:Label text="ЗОЛОТО" class="t-caption" />
                        <ui:Label name="gold-value" text="0" class="stat__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:Label text="РУДА" class="t-caption" />
                        <ui:Label name="ore-value" text="0" class="stat__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:Label text="НАСЕЛЕНИЕ" class="t-caption" />
                        <ui:Label name="population-value" text="0" class="stat__value" />
                        <ui:Label name="population-idle" text="" class="stat__note" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat">
                        <ui:Label text="ПРОДАНО" class="t-caption" />
                        <ui:Label name="sold-value" text="0" class="stat__value" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:VisualElement name="top-actions" class="top-actions" picking-mode="Ignore">
                    <ui:Button name="idle-button" class="btn">
                        <ui:Label text="Свободный" class="btn__caption" picking-mode="Ignore" />
                        <ui:Label text="1" class="hotkey" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="grid-button" class="btn">
                        <ui:Label text="Сетка" class="btn__caption" picking-mode="Ignore" />
                        <ui:Label text="G" class="hotkey" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="battle-button" text="В БОЙ" class="btn btn--gold battle-button" />
                    <ui:Button name="catalog-button" text="Каталог" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="middle" class="middle" picking-mode="Ignore">
                <ui:VisualElement name="left-column" class="left-column" picking-mode="Ignore">
                    <ui:VisualElement name="quest" class="panel quest">
                        <ui:VisualElement class="quest__header">
                            <ui:Label name="quest-chapter" class="quest__chapter t-caption" />
                            <ui:Button name="quest-toggle" text="−" class="btn btn-close quest__toggle" />
                        </ui:VisualElement>
                        <ui:Label name="quest-title" class="quest__title t-bold" />
                        <ui:VisualElement name="quest-body" class="quest__body">
                            <ui:Label name="quest-description" class="quest__description" />
                            <ui:VisualElement name="quest-goals" class="quest__goals" />
                            <ui:VisualElement class="quest__reward">
                                <ui:Label text="НАГРАДА" class="t-caption quest__reward-caption" />
                                <ui:VisualElement name="quest-reward-items" class="quest__reward-items" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="quest-claim" class="btn btn--gold quest__claim">
                            <ui:Label text="ЗАБРАТЬ НАГРАДУ" class="btn__caption" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="inspect" class="panel inspect">
                        <ui:VisualElement class="inspect__header">
                            <ui:VisualElement class="inspect__titles">
                                <ui:Label name="inspect-title" class="inspect__title t-bold" />
                                <ui:Label name="inspect-subtitle" class="inspect__subtitle t-medium" />
                            </ui:VisualElement>
                            <ui:Button name="inspect-close" text="×" class="btn btn-close" />
                        </ui:VisualElement>
                        <ui:VisualElement class="divider" />
                        <ui:VisualElement name="inspect-rows" />
                        <ui:Label name="inspect-note" class="note" />
                        <ui:Label name="inspect-slots-header" class="slots-header t-medium" />
                        <ui:VisualElement name="inspect-slots" class="slots" />
                        <ui:ScrollView name="inspect-staff-scroll" class="staff-scroll">
                            <ui:VisualElement name="inspect-staff" class="staff-list" />
                        </ui:ScrollView>
                        <ui:VisualElement name="inspect-actions" class="actions" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:VisualElement name="right-column" class="right-column" picking-mode="Ignore">
                    <ui:VisualElement name="showcase" class="panel showcase">
                        <ui:VisualElement class="showcase__header">
                            <ui:Label name="showcase-title" class="showcase__title t-bold" />
                            <ui:Button name="showcase-close" text="×" class="btn btn-close" />
                        </ui:VisualElement>
                        <ui:VisualElement name="showcase-image" class="showcase__image" />
                        <ui:Label name="showcase-caption" class="showcase__caption t-muted" />
                    </ui:VisualElement>
                    <ui:VisualElement name="catalog" class="panel catalog">
                        <ui:VisualElement class="catalog__header">
                            <ui:Label text="КАТАЛОГ" class="catalog__title t-bold" />
                            <ui:Button name="catalog-close" text="×" class="btn btn-close" />
                        </ui:VisualElement>
                        <ui:VisualElement class="tabs">
                            <ui:Button name="tab-units" text="Существа" class="btn tab" />
                            <ui:Button name="tab-buildings" text="Здания" class="btn tab" />
                        </ui:VisualElement>
                        <ui:VisualElement name="units-page" class="catalog__page">
                            <ui:VisualElement class="stepper">
                                <ui:Label text="Нанимать группой" class="stepper__label" />
                                <ui:Button name="hire-less" text="−" class="btn btn-icon" />
                                <ui:Label name="hire-amount" text="1" class="stepper__value t-bold" />
                                <ui:Button name="hire-more" text="+" class="btn btn-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement name="unit-cards" />
                        </ui:VisualElement>
                        <ui:ScrollView name="buildings-page" class="catalog__page" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom" class="bottom" picking-mode="Ignore">
                <ui:VisualElement name="status" class="panel status">
                    <ui:Label name="status-text" class="status__text" />
                </ui:VisualElement>
                <ui:VisualElement name="context" class="panel context">
                    <ui:VisualElement name="context-targets" class="context__targets" />
                    <ui:VisualElement class="context__row">
                        <ui:VisualElement class="context__text">
                            <ui:Label name="context-title" class="context__title" />
                            <ui:Label name="context-prompt" class="context__prompt" />
                        </ui:VisualElement>
                        <ui:VisualElement name="context-actions" class="context__actions" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="fan-layer" class="layer" picking-mode="Ignore">
            <ui:VisualElement name="command-fan" class="fan" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="haul-cargo-overlay" class="overlay overlay--soft">
            <ui:VisualElement name="haul-cargo-dialog" class="panel panel--solid cargo-dialog">
                <ui:Label name="haul-cargo-title" class="cargo-dialog__title t-bold" />
                <ui:Label text="Отметьте один или несколько товаров или оставьте «Всё». Куда носить — укажете на карте." class="cargo-dialog__text" />
                <ui:VisualElement name="haul-cargo-choices" class="cargo-dialog__choices" picking-mode="Ignore" />
                <ui:Label name="haul-cargo-note" class="cargo-dialog__note" />
                <ui:VisualElement name="haul-cargo-actions" class="cargo-dialog__actions" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="reward-overlay" class="overlay overlay--deep">
            <ui:VisualElement name="reward-dialog" class="panel reward">
                <ui:Label name="reward-eyebrow" class="reward__eyebrow t-caption" />
                <ui:Label name="reward-quest" class="reward__quest t-bold" />
                <ui:VisualElement name="reward-stage" class="reward__stage">
                    <ui:VisualElement name="reward-rays" class="reward__rays" picking-mode="Ignore" />
                    <ui:VisualElement name="reward-window" class="reward__window" picking-mode="Ignore">
                        <ui:VisualElement name="reward-prize" class="reward__prize" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="reward-sparks" class="reward__sparks" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="reward-kind" class="reward__kind t-caption" />
                <ui:Label name="reward-name" class="reward__name t-bold" />
                <ui:Label name="reward-description" class="reward__description" />
                <ui:VisualElement name="reward-extras" class="reward__extras" />
                <ui:Button name="reward-claim" class="btn btn--gold reward__claim">
                    <ui:Label text="ЗАБРАТЬ" class="btn__caption" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="battle-reward-overlay" class="overlay overlay--deep">
            <ui:VisualElement name="battle-reward-dialog" class="panel jackpot">
                <ui:Label text="ПОБЕДА!" class="jackpot__eyebrow t-bold" />
                <ui:Label name="battle-reward-title" class="jackpot__title t-medium" />
                <ui:VisualElement name="battle-reward-machine" class="jackpot__machine">
                    <ui:VisualElement name="battle-reward-reels" class="jackpot__reels" picking-mode="Ignore" />
                    <ui:VisualElement name="battle-reward-lights" class="jackpot__lights" picking-mode="Ignore" />
                    <ui:VisualElement name="battle-reward-sparks" class="jackpot__sparks" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="battle-reward-range" class="jackpot__range" />
                <ui:Label name="battle-reward-amount" class="jackpot__amount t-bold" />
                <ui:Button name="battle-reward-claim" class="btn btn--gold jackpot__claim">
                    <ui:Label text="ЗАБРАТЬ ЗОЛОТО" class="btn__caption" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cheat-overlay" class="overlay">
            <ui:VisualElement class="panel dialog">
                <ui:VisualElement class="dialog__header">
                    <ui:Label text="ЧИТ-МЕНЮ · F1" class="dialog__title t-bold" />
                    <ui:Button name="cheat-close" text="×" class="btn btn-close" />
                </ui:VisualElement>
                <ui:Label text="Миссия 1 без ожидания открытия и перезарядки." class="dialog__text" />
                <ui:Button name="cheat-prepare" text="Открыть расстановку" class="btn" />
                <ui:Button name="cheat-quick" text="Быстрый бой" class="btn btn--primary" />
                <ui:Button name="cheat-quest" text="Выполнить текущее задание" class="btn" />
                <ui:Label name="cheat-status" text="Если бойцов нет, быстрый бой наймёт 1 тролля и 3 гоблинов." class="note" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
