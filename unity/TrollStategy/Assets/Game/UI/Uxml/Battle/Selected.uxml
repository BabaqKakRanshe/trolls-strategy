<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../../Styles/Theme.uss" />
    <ui:Style src="../../Styles/BattleHud.uss" />
    <ui:VisualElement name="battle-selected" class="panel battle-panel battle-selected">
        <ui:VisualElement class="battle-panel__header">
            <ui:Label text="2 · РАССТАНОВКА И СНАРЯЖЕНИЕ" class="battle-panel__title t-bold" />
            <ui:Button name="battle-remove" text="Убрать с поля" class="btn btn--danger battle-panel__action" />
        </ui:VisualElement>
        <ui:Label name="battle-selection" class="battle-selected__details" />
        <ui:Label text="СНАРЯЖЕНИЕ · нажми предмет, чтобы надеть или снять" class="t-caption battle-selected__caption" />
        <ui:ScrollView name="battle-gear-list" class="battle-list" />
        <ui:Label name="battle-gear-empty" text="Снаряжения нет · можно начать бой без него" class="note" />
    </ui:VisualElement>
</ui:UXML>
