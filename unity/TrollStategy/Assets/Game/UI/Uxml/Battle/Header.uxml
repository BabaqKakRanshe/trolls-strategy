<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../../Styles/Theme.uss" />
    <ui:Style src="../../Styles/BattleHud.uss" />
    <ui:VisualElement name="battle-header" class="panel battle-header">
        <ui:VisualElement class="battle-header__text" picking-mode="Ignore">
            <ui:Label name="battle-title" class="battle-header__title t-bold" />
            <ui:Label name="battle-goal" class="battle-header__goal" />
            <ui:Label name="battle-guide" class="battle-header__guide t-medium" />
        </ui:VisualElement>
        <ui:Button name="battle-back" text="В КОЛОНИЮ" class="btn battle-header__back" />
    </ui:VisualElement>
</ui:UXML>
