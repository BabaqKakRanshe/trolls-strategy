<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../../Styles/Theme.uss" />
    <ui:Style src="../../Styles/ColonyHud.uss" />
    <ui:Style src="../../Styles/Progression.uss" />
    <!-- a tray of round tokens along the bottom; CatalogPanel builds the tokens -->
    <ui:VisualElement name="catalog" class="catalog" picking-mode="Ignore">
        <ui:VisualElement class="catalog__side halo" picking-mode="Ignore">
            <ui:Button name="tab-units" text="Существа" class="tab" />
            <ui:Button name="tab-buildings" text="Здания" class="tab" />
            <ui:Button name="catalog-close" text="×" class="btn btn-close catalog__close" />
        </ui:VisualElement>
        <ui:VisualElement name="units-page" class="catalog__page" picking-mode="Ignore">
            <ui:VisualElement class="stepper halo" picking-mode="Ignore">
                <ui:Label text="Нанимать по" class="stepper__label" picking-mode="Ignore" />
                <ui:VisualElement class="stepper__row" picking-mode="Ignore">
                    <ui:Button name="hire-less" text="−" class="btn btn-icon" />
                    <ui:Label name="hire-amount" text="1" class="stepper__value t-black" picking-mode="Ignore" />
                    <ui:Button name="hire-more" text="+" class="btn btn-icon" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- a page of tokens at a time: arrows at the tray's ends, a dot per page above it (CatalogPager) -->
            <ui:VisualElement class="catalog-pager" picking-mode="Ignore">
                <ui:Button name="unit-prev" class="btn-disc catalog-arrow catalog-arrow--prev"><ui:VisualElement class="glyph glyph--chevron catalog-arrow__glyph" picking-mode="Ignore" /></ui:Button>
                <ui:VisualElement name="unit-cards" class="tray tray--row halo" picking-mode="Ignore" />
                <ui:Button name="unit-next" class="btn-disc catalog-arrow catalog-arrow--next"><ui:VisualElement class="glyph glyph--chevron catalog-arrow__glyph" picking-mode="Ignore" /></ui:Button>
                <ui:VisualElement name="unit-dots" class="catalog-dots" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="buildings-page" class="catalog__page" picking-mode="Ignore">
            <ui:VisualElement class="catalog-pager" picking-mode="Ignore">
                <ui:Button name="building-prev" class="btn-disc catalog-arrow catalog-arrow--prev"><ui:VisualElement class="glyph glyph--chevron catalog-arrow__glyph" picking-mode="Ignore" /></ui:Button>
                <ui:VisualElement name="building-cards" class="tray tray--row halo" picking-mode="Ignore" />
                <ui:Button name="building-next" class="btn-disc catalog-arrow catalog-arrow--next"><ui:VisualElement class="glyph glyph--chevron catalog-arrow__glyph" picking-mode="Ignore" /></ui:Button>
                <ui:VisualElement name="building-dots" class="catalog-dots" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
