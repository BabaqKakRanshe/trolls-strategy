<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../../Styles/Theme.uss" />
    <ui:Style src="../../Styles/ColonyHud.uss" />
    <ui:Style src="../../Styles/Progression.uss" />
    <ui:VisualElement name="battle-reward-overlay" class="overlay overlay--deep">
        <!-- no card: the battle's banner, then one white disc per digit (BattleRewardOverlay builds them) -->
        <ui:VisualElement name="battle-reward-dialog" class="jackpot halo">
            <ui:Label name="battle-reward-banner" text="Победа!" class="jackpot__banner t-black" />
            <ui:Label name="battle-reward-title" class="jackpot__title t-medium" />
            <ui:VisualElement name="battle-reward-machine" class="jackpot__machine">
                <ui:VisualElement name="battle-reward-reels" class="jackpot__reels" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="battle-reward-range" class="jackpot__range t-medium" />
            <ui:Label name="battle-reward-amount" class="jackpot__amount t-black" />
            <ui:Button name="battle-reward-claim" class="btn btn--gold jackpot__claim">
                <ui:Label text="Забрать золото" class="btn__caption" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- the coins on their way to the treasury: over the veil, which lifts under them -->
    <ui:VisualElement name="battle-reward-flight" class="jackpot__flight" picking-mode="Ignore" />
</ui:UXML>
