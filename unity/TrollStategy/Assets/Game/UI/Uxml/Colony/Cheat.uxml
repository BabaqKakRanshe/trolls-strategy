<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../../Styles/Theme.uss" />
    <ui:Style src="../../Styles/ColonyHud.uss" />
    <ui:Style src="../../Styles/Progression.uss" />
    <ui:VisualElement name="cheat-overlay" class="overlay">
        <ui:VisualElement class="sheet dialog">
            <ui:VisualElement class="dialog__header">
                <ui:Label text="Чит-меню" class="dialog__title dialog__title--fit t-black" />
                <ui:Label text="F1" class="hotkey" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="cheat-close" text="×" class="btn btn-close" />
            </ui:VisualElement>
            <ui:Label text="Миссия 1 без ожидания открытия и перезарядки." class="dialog__text" />
            <ui:Button name="cheat-prepare" text="Открыть расстановку" class="btn" />
            <ui:Button name="cheat-quick" text="Быстрый бой" class="btn btn--primary" />
            <ui:Button name="cheat-quest" text="Выполнить текущее задание" class="btn" />
            <ui:Button name="cheat-land-buy" text="Купить всю землю" class="btn" />
            <ui:Button name="cheat-land-clear" text="Расчистить всю землю" class="btn" />
            <ui:Button name="cheat-buildings" text="Открыть все постройки" class="btn" />
            <!-- the caption says how many of each item: CheatPanel writes it with its number -->
            <ui:Button name="cheat-gear" class="btn" />
            <ui:Button name="cheat-gold" text="+1000 золота" class="btn btn--gold" />
            <ui:Label name="cheat-status" text="Если бойцов нет, быстрый бой наймёт 1 тролля и 3 гоблинов." class="note" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
